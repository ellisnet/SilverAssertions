<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Run via Microsoft.Testing.Platform rather than VSTest -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <OutputType>Exe</OutputType>
    <RootNamespace>NUnit4.Tests</RootNamespace>
    <AssemblyName>NUnit4.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <!-- No IncludeAssets filter: the MTP runner's generated entry point must
         compile against Microsoft.Testing.Platform, which this adapter brings
         in transitively. Excluding "compile" assets breaks the build. -->
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SilverAssertions\SilverAssertions.csproj" />
  </ItemGroup>
</Project>